// 1단계 스키마 — docs/phase1-design.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Lang {
  ko
  en
  zh
  ja
  vi

  @@map("lang")
}

enum FeedbackType {
  general
  translation
  guide
  bug

  @@map("feedback_type")
}

enum FeedbackStatus {
  new
  read
  resolved

  @@map("feedback_status")
}

enum EventType {
  landing_view
  list_view
  form_view
  form_download
  language_select
  search
  category_filter
  feedback_click
  detail_time
  fill_start
  field_open
  fill_preview
  fill_png_save
  fill_print
  fill_reset

  @@map("event_type")
}

model Feedback {
  id        String         @id @default(uuid()) @db.Uuid
  lang      Lang
  formKey   String?        @map("form_key")
  formNo    Int?           @map("form_no") @db.SmallInt
  fieldId   String?        @map("field_id")
  type      FeedbackType   @default(general)
  message   String
  status    FeedbackStatus @default(new)
  ipHash    String?        @map("ip_hash") @db.Char(64)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)])
  @@index([formKey])
  @@index([ipHash, createdAt])
  @@map("feedback")
}

model UsageEvent {
  id          BigInt    @id @default(autoincrement())
  type        EventType
  lang        Lang?
  formKey     String?   @map("form_key")
  formNo      Int?      @map("form_no") @db.SmallInt
  fieldId     String?   @map("field_id")
  category    String?
  searchTerm  String?   @map("search_term")
  resultCount Int?      @map("result_count")
  durationSec Int?      @map("duration_sec")
  visitorId   String    @map("visitor_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([type, createdAt])
  @@index([formKey, type])
  @@index([createdAt])
  @@map("usage_event")
}

// ── 관리자 (2026-11-04) ──

/** 관리자 계정. 가입 화면 없이 NAS에서 명령으로 만든다 (src/cli/admin-user.ts) */
model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  /** scrypt$N$r$p$salt$hash (원래 비밀번호는 저장하지 않음) */
  passwordHash String    @map("password_hash")
  disabled     Boolean   @default(false)
  /** 연속 실패 수. 5번이면 15분 잠금, 로그인 성공 시 0 */
  failedCount  Int       @default(0) @map("failed_count") @db.SmallInt
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions AdminSession[]

  @@map("admin_user")
}

/** 로그인 세션. 쿠키 값은 저장하지 않고 SHA-256 해시만 id로 둔다 */
model AdminSession {
  id         String    @id @db.Char(64)
  userId     String    @map("user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /** 처음 로그인부터 최대 유지 시각 */
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_session")
}

/** 관리 기록: 누가 언제 무엇을 했는지 (피드백 본문은 남기지 않는다) */
model AdminAuditLog {
  id        BigInt   @id @default(autoincrement())
  /** 계정이 지워져도 기록은 남도록 이름을 그대로 적는다. 토큰으로 한 일은 'token' */
  actor     String
  action    String
  target    String?
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_log")
}
