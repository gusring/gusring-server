// 1단계 스키마 — docs/phase1-design.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Lang {
  ko
  en
  zh
  ja
  vi

  @@map("lang")
}

enum FeedbackType {
  general
  translation
  guide
  bug

  @@map("feedback_type")
}

enum FeedbackStatus {
  new
  read
  resolved

  @@map("feedback_status")
}

enum EventType {
  landing_view
  list_view
  form_view
  form_download
  language_select
  search
  category_filter
  feedback_click
  detail_time
  fill_start
  field_open
  fill_preview
  fill_png_save
  fill_print
  fill_reset

  @@map("event_type")
}

model Feedback {
  id        String         @id @default(uuid()) @db.Uuid
  lang      Lang
  formKey   String?        @map("form_key")
  formNo    Int?           @map("form_no") @db.SmallInt
  fieldId   String?        @map("field_id")
  type      FeedbackType   @default(general)
  message   String
  status    FeedbackStatus @default(new)
  ipHash    String?        @map("ip_hash") @db.Char(64)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)])
  @@index([formKey])
  @@index([ipHash, createdAt])
  @@map("feedback")
}

model UsageEvent {
  id          BigInt    @id @default(autoincrement())
  type        EventType
  lang        Lang?
  formKey     String?   @map("form_key")
  formNo      Int?      @map("form_no") @db.SmallInt
  fieldId     String?   @map("field_id")
  category    String?
  searchTerm  String?   @map("search_term")
  resultCount Int?      @map("result_count")
  durationSec Int?      @map("duration_sec")
  visitorId   String    @map("visitor_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([type, createdAt])
  @@index([formKey, type])
  @@index([createdAt])
  @@map("usage_event")
}

// ── 관리자 (2026-11-04) ──

/** manager: 계정 관리까지, staff: 통계·피드백만 */
enum AdminRole {
  manager
  staff

  @@map("admin_role")
}

/** 관리자 계정. 가입 화면은 없다. 계정 관리자가 화면에서 만들거나, 비상시 NAS 명령으로 만든다 (src/cli/admin-user.ts) */
model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  /** scrypt$N$r$p$salt$hash (원래 비밀번호는 저장하지 않음) */
  passwordHash String    @map("password_hash")
  role         AdminRole @default(staff)
  /** 다른 사람이 정해 준 임시 비밀번호면 true. 바꾸기 전에는 비밀번호 바꾸기 말고는 못 쓴다 */
  mustChangePassword Boolean @default(false) @map("must_change_password")
  disabled     Boolean   @default(false)
  /** 연속 실패 수. 5번이면 15분 잠금, 로그인 성공 시 0 */
  failedCount  Int       @default(0) @map("failed_count") @db.SmallInt
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions AdminSession[]

  @@map("admin_user")
}

/** 로그인 세션. 쿠키 값은 저장하지 않고 SHA-256 해시만 id로 둔다 */
model AdminSession {
  id         String    @id @db.Char(64)
  userId     String    @map("user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /** 처음 로그인부터 최대 유지 시각 */
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_session")
}

/** 관리 기록: 누가 언제 무엇을 했는지 (피드백 본문은 남기지 않는다) */
model AdminAuditLog {
  id        BigInt   @id @default(autoincrement())
  /** 계정이 지워져도 기록은 남도록 이름을 그대로 적는다. 토큰으로 한 일은 'token' */
  actor     String
  action    String
  target    String?
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_log")
}

// ── 서식 정의 (2026-11-25) ──

/** 서식 하나. 관리자가 고치는 것은 draft, 이용자에게 보이는 것은 publishedVersion이 가리키는 form_version */
model Form {
  id               String    @id @default(uuid()) @db.Uuid
  /** 영어 kebab-case (예: birth-report). 지운 서식도 자리를 차지한다 */
  key              String    @unique
  formNo           Int       @unique @map("form_no") @db.SmallInt
  /** 고치는 중인 서식 정의 전체 (src/domains/form/form.schema.ts formDefinition) */
  draft            Json
  /** 동시에 고칠 때 덮어쓰기 방지용 (PATCH baseUpdatedAt과 비교). 서버가 ms 단위로 넣는다 */
  draftUpdatedAt   DateTime  @map("draft_updated_at") @db.Timestamptz(3)
  draftUpdatedBy   String    @map("draft_updated_by")
  /** NULL이면 이용자에게 안 보임 */
  publishedVersion Int?      @map("published_version")
  /** NULL이 아니면 지운 서식 (판은 남긴다) */
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions FormVersion[]

  @@map("form")
}

/** 공개한 판. 고치지 않고 쌓기만 한다 */
model FormVersion {
  formId      String   @map("form_id") @db.Uuid
  version     Int
  definition  Json
  publishedBy String   @map("published_by")
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  form Form @relation(fields: [formId], references: [id], onDelete: Restrict)

  @@id([formId, version])
  @@map("form_version")
}

/** 서식 원본 이미지(PNG). id = 내용의 SHA-256이라 같은 파일은 한 번만. DB에 두어 매일 백업(pg_dump)에 같이 들어간다 */
model FormImage {
  id        String   @id @db.Char(64)
  width     Int
  height    Int
  bytes     Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("form_image")
}
