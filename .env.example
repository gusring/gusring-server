# 복사해서 .env 로 쓰세요 (.env 는 git에 올라가지 않음)
PORT=4000
# 허용할 프론트 주소 (쉼표로 구분)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://gusring-guide.vercel.app
# 앞단 프록시 개수. 로컬 0, Vercel 배포 시 1
TRUST_PROXY=0

# 로컬 개발 DB (docker compose). 배포 시 Supabase 주소로
DATABASE_URL=postgresql://gusring:gusring@localhost:5433/gusring

# 관리자 API 토큰 — 길고 무작위로. 만드는 법:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=
# IP 해시에 섞는 비밀값 — 위와 같은 방법으로 (32바이트 이상 권장). 바꾸면 도배 제한 기록이 초기화됨
IP_HASH_SECRET=
