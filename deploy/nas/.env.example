# NAS /share/Container/gusring/.env 로 복사해 채운다. 권한은 600 (chmod 600 .env)
# 비밀값 만드는 법: openssl rand -base64 48 | tr -d '/+=' | cut -c1-40

# 이미지 태그 (git 커밋 앞 7자리)
TAG=
POSTGRES_PASSWORD=
# 스크립트용 관리자 토큰 (선택). 사람은 아이디·비밀번호로 로그인 (README '관리자 계정')
ADMIN_TOKEN=
IP_HASH_SECRET=
CORS_ORIGIN=https://gusring-guide.vercel.app

# 외부 접속
API_DOMAIN=gusring.kro.kr
PUBLIC_IP=223.194.166.7
# 공인망 게이트웨이 (Nginx 기본 경로, nginx/public-route.sh). 비우면 223.194.166.1
PUBLIC_GW=223.194.166.1
QNET_NAME=qnet-static-bond0-272384
