# 인증서를 받기 전에 쓰는 설정: 인증 확인 파일만 내주고 나머지는 503

# 응답 헤더에 Nginx 버전을 드러내지 않는다
server_tokens off;

server {
    listen 80 default_server;
    return 444;
}
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 80;
    server_name ${API_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        # 앱과 같은 실패 형식 (src/constants/error-code.ts의 COMMON_NOT_READY)
        default_type application/json;
        return 503 '{"success":false,"message":"아직 준비 중입니다.","error":{"code":"COMMON_NOT_READY"}}';
    }
}
